# Frontend (Next.js) environment.
# Copy to .env.local and adjust for your setup.

# Base URL of the backend API. Defaults to http://localhost:5000/api if unset.
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Google Sign-In (optional). Create a free OAuth 2.0 Client ID (Web application)
# in Google Cloud Console, add http://localhost:3000 as an authorized JavaScript
# origin, then paste the Client ID here. Without it, the Google button is hidden.
#   Frontend (.env.local):  NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
#   Backend  (server/.env): GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
