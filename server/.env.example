PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/memoracare
JWT_SECRET=your_jwt_secret_key_here_change_in_production
JWT_EXPIRE=7d

# AI Chatbot (Phase 4) — custom NLP model served by the Python/Flask ml-service.
# Start it with:  cd ml-service && python train.py && python app.py
# If the service is offline, the chatbot falls back to simple rule-based replies.
ML_SERVICE_URL=http://localhost:5001

# Wit.ai cloud NLU (optional, PRIMARY chatbot classifier when set). Get a
# "Server Access Token" from your Wit.ai app's Settings page. If WIT_TOKEN is
# unset, the chatbot uses the self-hosted Python model above as the classifier.
# WIT_MIN_CONFIDENCE: below this, we fall back to the Python model (default 0.55).
WIT_TOKEN=
WIT_MIN_CONFIDENCE=0.55

# Frontend origin for CORS in production (your Vercel URL). Localhost + *.vercel.app
# are always allowed; set this to your exact deployed domain.
CLIENT_URL=https://your-app.vercel.app

# Email (optional). If these are set, MemoryCare sends welcome, caregiver-alert
# and password-reset emails; if unset, email is silently skipped for welcome/
# alerts (app still works), and "forgot password" returns a clear "email not
# configured" message. Works with any SMTP provider — e.g. Gmail app password,
# Brevo, SendGrid SMTP. Note: CLIENT_URL (above) is used to build the reset link.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_smtp_username_or_email
EMAIL_PASS=your_smtp_password_or_app_password
EMAIL_FROM=MemoryCare <no-reply@yourdomain.com>
# EMAIL_SECURE=true   # only if using port 465
